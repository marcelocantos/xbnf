// SPDX-License-Identifier: Apache-2.0
//
// Coverage: YAML 1.2 documents in the pinned suite. One node per document.
// Events, not construct.

doc -> NEWLINE* (directive NEWLINE*)* docs NEWLINE* ;

docs -> docs_head docs_rest ;
docs_head -> (doc_start NEWLINE* tagged_or_node | tagged_or_node) #longest ;
docs_rest -> (NEWLINE* doc_start NEWLINE* tagged_or_node)* (NEWLINE* doc_end)? ;

tagged_or_node -> (tagged | node) #longest ;

directive -> "%" /[^\n]+/ NEWLINE ;
doc_start -> "---" ;
doc_end -> "..." ;

node -> (flow | block_seq | block_map | anchored | alias | scalar) #longest ;

anchored -> "&" IDENT node ;

tagged -> tag NEWLINE? tagged_body ;
tagged_body -> (doc_scalar | node) #longest ;
tag -> "!!" /[A-Za-z0-9]+/ | "!" /[A-Za-z0-9]*/ ;

alias -> "*" IDENT ;

block_seq -> seq_item (NEWLINE+ seq_item)* ;
seq_item -> "-" NEWLINE? seq_val ;
seq_val -> (tagged | flow | anchored | alias | block_map | scalar) #longest ;

block_map -> map_entry (NEWLINE+ map_entry)* ;
map_entry -> (explicit_key | implicit_key) #longest ;
explicit_key -> "?" [ \t]* key NEWLINE ":" [ \t]* val ;
implicit_key -> key ":" after_colon ;
after_colon -> (NEWLINE val | val | ()) #longest ;

key -> (alias | STR | IDENT | flow_key | ":" ) #longest ;
val -> (tagged | flow | anchored | alias | fold_scalar | scalar | node) #longest ;

fold_scalar -> /{ #wrap -> () ; [^\n]+ ; }/
               (NEWLINE [ \t]+ /{ #wrap -> () ; [^\n]+ ; }/ )* ;

doc_scalar -> /{ #wrap -> () ; [^\n]+ ; }/
              (NEWLINE (?! "---") /{ #wrap -> () ; [^\n]+ ; }/ )* ;

flow -> "[" flow_chunk* "]"
      | "{" /{ #wrap -> () ; [^}]* ; }/ "}" ;
flow_chunk -> (flow | /{ #wrap -> () ; [^\[\]]+ ; }/) #longest ;

flow_el -> (flow_pair | flow | tagged | alias | flow_plain | scalar) #longest ;
flow_pair -> flow_key ":" val ;
flow_key -> (flow | STR | IDENT | flow_plain ([ \t]+ flow_plain)*) #longest ;
flow_plain -> /{ #wrap -> () ; [^ \t,{}\[\]]+ ; }/ ;

scalar -> STR | NUMBER | IDENT | alias | block_plain ;

block_plain -> /{ #wrap -> () ; [^:\n#[\]{}&*!?-] [^:\n]* ; }/ ;

nl -> NEWLINE* ;

IDENT -> /{ #wrap -> () ; [A-Za-z_] [A-Za-z0-9_]* ; }/ ;
STR -> /{ #wrap -> () ;
    '"' ([^"\\] | "\\" . | "\n")* '"'
  | "'" [^']* "'" ;
}/ ;
NUMBER -> /{ #wrap -> () ; "-"? [0-9]+ ("." [0-9]+)? ; }/ ;
NEWLINE -> /{ #wrap -> () ; \n ; }/ ;

#wrap -> [ \t]* ;

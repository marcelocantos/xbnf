//
// Not a conformant C++ parser. This is a CFG subset used to probe xbnf, not ISO
// C++. It has no name lookup, so it cannot distinguish declarations from
// expressions (A * B;), no classes or templates, and no preprocessor (input is
// already preprocessed). Overload resolution and Clang semantics are out of
// band. Historical T22 artefact; the live C-family track is Go.

tu -> decl+ ;

decl -> (func | glob) #longest ;

glob -> type IDENT "=" expr ";" ;

func -> type IDENT "(" params? ")" block ;

params -> param:"," ;
param -> type IDENT ;

type -> "int" | "void" | "bool" ;

block -> "{" stmt* "}" ;

stmt -> ("return" expr? ";"
      | "if" "(" expr ")" stmt ("else" stmt)?
      | block
      | type IDENT "=" expr ";"
      | expr ";") #longest ;

relop -> ("==" | "!=" | "=" | "<" | ">") #longest ;

expr -> @:op=("||" | "&&")
      > @:op=relop
      > @:op=("+" | "-") #assoc=left
      > @:op=("*" | "/") #assoc=left
      > atom ;

atom -> (IDENT ("(" (expr:",")? ")")?
      | NUMBER
      | "(" expr ")"
      | "true" | "false") #longest ;

IDENT -> /{ #wrap -> () ;
    (?!KEYWORD) [A-Za-z_] [A-Za-z0-9_]* ;
}/ ;

KEYWORD -> /{ #wrap -> () ;
    ("int" | "void" | "bool" | "return" | "if" | "else" | "true" | "false")
    (?![A-Za-z0-9_]) ;
}/ ;

NUMBER -> /{ #wrap -> () ; [0-9]+ ; }/ ;

COMMENT -> /{ #wrap -> () ; "//" [^\n]* | "/*" ([^*] | "*" [^/])* "*/" ; }/ ;

#wrap -> (\s | COMMENT)* ;

//
// Coverage: ECMAScript Script with comments, empty statements, if/throw,
// calls, !== / ===, string concat. No regexp lexical goal, no ASI, no JSX/TS.

script -> stmt* ;

stmt -> ("function" IDENT "(" params? ")" block
      | ("let" | "const" | "var") IDENT "=" expr ";"
      | "return" expr? ";"
      | "throw" expr ";"
      | "if" "(" expr ")" stmt ("else" stmt)?
      | "try" block ("catch" "(" IDENT? ")" block)? ("finally" block)?
      | block
      | ";"
      | expr ";") #longest ;

params -> IDENT:"," ;

block -> "{" stmt* "}" ;

relop -> ("===" | "!==" | "==" | "!=" | "=") #longest ;

expr -> @:op=("||" | "&&")
      > @:op=relop
      > @:op=("+" | "-") #assoc=left
      > @:op=("*" | "/") #assoc=left
      > trailer ;

trailer -> atom postfix* ;

postfix -> ("." IDENT | "(" args? ")" | "[" expr "]") #longest ;

args -> expr:"," ;

atom -> ("new" IDENT ("(" args? ")")?
      | IDENT
      | NUMBER
      | STR
      | "(" expr ")"
      | "true" | "false" | "null") #longest ;

IDENT -> /{ #wrap -> () ;
    (?!KEYWORD) [A-Za-z_$] [A-Za-z0-9_$]* ;
}/ ;

KEYWORD -> /{ #wrap -> () ;
    ("function" | "let" | "const" | "var" | "return" | "if" | "else"
    | "true" | "false" | "null" | "throw" | "try" | "catch" | "finally" | "new")
    (?![A-Za-z0-9_$]) ;
}/ ;

NUMBER -> /{ #wrap -> () ; [0-9]+ ; }/ ;
STR -> /{ #wrap -> () ; '"' ([^"\\] | "\\" .)* '"' | "'" ([^'\\] | "\\" .)* "'" ; }/ ;
COMMENT -> /{ #wrap -> () ; "//" [^\n]* | "/*" ([^*] | "*" [^/])* "*/" ; }/ ;

#wrap -> (\s | COMMENT)* ;

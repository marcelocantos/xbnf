//
// Coverage: CommonMark blocks enough to consume the pinned README/changelog:
// ATX/setext headings, fences, lists, indented code, HTML/autolink lines,
// reference definitions, paragraphs. Inlines are line text. cmark is the oracle.

doc -> NEWLINE* (block NEWLINE*)* ;

block -> (fence | atx | setext | list_item | indent_code | html_line | refdef | para | rule | indented) #longest ;

atx -> [ \t]* "#"{1,6} ([ \t]+ /[^\n]*/)? "\n" ;

setext -> /[^#\n][^\n]*/ "\n" [ \t]* ("="+ | "-"+) "\n" ;

fence -> [ \t]* "`"{3,} /[^\n]*/ "\n" /([^`] | "`" [^`] | "``" [^`])*/ [ \t]* "`"{3,} "\n"?
       | [ \t]* "~"{3,} /[^\n]*/ "\n" /([^~] | "~" [^~])*/ [ \t]* "~"{3,} "\n"? ;

list_item -> [ \t]* ("-" | "*" | "+" | /[0-9]+/ ".") [ \t]* /[^\n]*/ "\n"
             ( [ \t]+ /[^\n]*/ "\n" )* ;

indented -> [ \t]+ /[^\n]*/ "\n" ;

indent_code -> ("    " | "\t") /[^\n]*/ "\n" ;

html_line -> [ \t]* "<" /[^\n]*/ "\n" ;

refdef -> [ \t]* "[" /[^\]\n]+/ "]:" [ \t]* /[^\n]*/ "\n" ;

rule -> [ \t]* ("***" | "---" | "___") /[^\n]*/ "\n" ;

para -> (?! [ \t]* ("-" | "*" | "+" | "#" | "```" | "<")) /[^\n]+/ "\n" ;

NEWLINE -> /{ #wrap -> () ; \n ; }/ ;

#wrap -> () ;

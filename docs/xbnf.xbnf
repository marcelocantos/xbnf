// ===========================================================
// xbnf.xbnf — the xbnf grammar language defined in itself
// ===========================================================
//
// Key departures from wbnf:
//   '.'    any character (was pragma prefix)
//   '#'    pragma/directive sigil (new)
//   '|'    unordered alternation (was ordered/PEG)
//   /term/ leaf collapse (same language, one string in the tree)
//   <: :>  gone; use #assoc directive instead
//   /{…}/  gone; character classes are grammar-level
//   (?!…)  negative lookahead (new)
//
// Sigils:
//   .           any character
//   #keyword    pragma, directive, or rule modifier
//   @           Stack self-ref (bare) or positional (@col)
//   %name       back-reference
//   %%name      external reference
//   %!name()    macro invocation
//   ::          label filter

// ── Structure ──────────────────────────────────────────────

grammar -> stmt+ ;

stmt -> COMMENT | rule | pragma ;

rule -> IDENT mod* "->" term ";" ;

mod -> "#" IDENT ;                           // #lex

pragma -> "#" IDENT "->" term ";"            // #wrap -> \s* ;
        | "#" IDENT STR ";"?                 // #import "path" ;
        | "#" IDENT IDENT                    // #macro name(args) { body }
          "(" IDENT:","? ")"
          "{" term "}" ";"? ;

// ── Terms ──────────────────────────────────────────────────
// Precedence stack (L1 loosest → L4 tightest):
//   L1  Stack levels     a > b > c
//   L2  Alternation      a | b | c   unordered
//                        a |> b |> c ordered; do not mix with |
//   L3  Sequence          a b c   (+ trailing directives)
//   L4  Atoms             "x"  [a-z]  \d  name  name?

term -> (@ ("{" scope "}")?):op=">"
      > ( (@ ("|" @)+) | (@ ("|>" @)+) | @ ) #longest
      > @+ directive*
      > named quant* ;

scope -> (rule | pragma)* term ";"? (rule | pragma)* ;

named -> (IDENT op="=")? atom ;

quant -> op=[?*+]
       | "{" INT ( "}" | "," max=INT? "}" )
       | "{" "," max=INT? "}"
       | ":" opt_leading=","? named opt_trailing=","? ;

directive -> "#" IDENT ("=" (IDENT | INT))? ;

atom -> (
        IDENT ("::" IDENT)?             // rule ref, optional label filter
      | STR                              // "string"
      | CHARCLASS                        // [a-z]
      | ESCAPE                           // \d
      | "/" term "/"                     // leaf collapse
      | "."                              // any character
      | REF                              // %name
      | EXTREF                           // %%name
      | MACRO_NAME "(" term:","? ")"     // %!name(args)
      | "(?=" term ")"                   // positive lookahead
      | "(?!" term ")"                   // negative lookahead
      | "(?i:" term ")"                  // case-fold match mode
      | "(?~i:" term ")"                 // restore case-sensitive matching
      | "@"                              // Stack self-reference
      | POS_PROP ("(" CMP ")")?          // @col  or  @col(=level)
      | "{" scope "}"                    // scoped wrap / locals
      | "(" term ")"                     // grouping
      | "(" ")"                          // empty
      ) #longest ;

CMP -> ("=" | "!=" | "<" | ">" | "<=" | ">=") IDENT ;

// ── Terminals ──────────────────────────────────────────────
// /term/ matches term (one language) and emits one string.
// Scoped #wrap -> () suppresses wrap between characters inside a token.

COMMENT -> /{ #wrap -> () ;
    "//" [^\n]*
  | "/*" ([^*] | "*" [^/])* "*/" ;
}/ ;

IDENT -> /{ #wrap -> () ;
    [A-Za-z_] [A-Za-z0-9_]* ;
}/ ;

INT -> /[0-9]+/ ;

STR -> /{ #wrap -> () ;
    '"' ("\\" . | [^"\\])* '"'
  | "'" ("\\" . | [^'\\])* "'"
  | "`" ("``"  | [^`]   )* "`" ;
}/ ;

CHARCLASS -> /{ #wrap -> () ;
    "[" "^"? cc_item+ "]" ;
    cc_item -> cc_atom ("-" cc_atom)? ;
    cc_atom -> "\\" . | [^\]\\] ;
}/ ;

ESCAPE -> /{ #wrap -> () ;
    "\\" [pP] "{" [A-Za-z] [A-Za-z0-9_]* "}"
  | "\\" [a-zA-Z0-9] ;
}/ ;

REF -> /{ #wrap -> () ;
    "%" [A-Za-z_] [A-Za-z0-9_]* ("=" STR)? ;
}/ ;

EXTREF -> /{ #wrap -> () ;
    "%%" [A-Za-z_] [A-Za-z0-9_]* ;
}/ ;

MACRO_NAME -> /{ #wrap -> () ;
    "%!" [A-Za-z_] [A-Za-z0-9_]* ;
}/ ;

POS_PROP -> /{ #wrap -> () ;
    "@" [A-Za-z_] [A-Za-z0-9_]* ;
}/ ;

// ── Default whitespace ─────────────────────────────────────

#wrap -> (\s | COMMENT)* ;

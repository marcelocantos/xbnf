// json.xbnf — JSON (RFC 8259)

json -> value ;

value -> object | array | STR | NUMBER | "true" | "false" | "null" ;

object -> "{" member:","? "}" ;
member -> STR ":" value ;

array -> "[" value:","? "]" ;

// ── Terminals ──────────────────────────────────────────────

NUMBER -> /{ #wrap -> () ;
    "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? ;
}/ ;

STR -> /{ #wrap -> () ;
    '"' ("\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}) | [^"\\])* '"' ;
}/ ;

#wrap -> \s* ;
